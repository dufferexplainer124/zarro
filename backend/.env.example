# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=zarro_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Payments ----
# 'test' uses the mock providers in backend/services/providers so checkout can
# be built and demoed without real gateway access. Switch to 'live' only once
# real API keys below are filled in and the live-mode code paths (marked with
# "Live mode placeholder" in each provider) are implemented.
PAYMENTS_MODE=test

# Card networks (Visa / Mastercard) — typically routed through one processor
# (Stripe, a local acquiring bank, etc). Fill in once you have real credentials.
VISA_API_KEY=
VISA_API_SECRET=
MASTERCARD_API_KEY=
MASTERCARD_API_SECRET=

# Local mobile wallets
EASYPAISA_MERCHANT_ID=
EASYPAISA_API_KEY=
JAZZCASH_MERCHANT_ID=
JAZZCASH_API_KEY=
